	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.a25e582c6c8214ce.1</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>A6XH46TK32.untracker</string>
	</array>
</dict>
</plist>
